  "instruction": {
    "text": {
      "ru": "Расставь картинки по порядку: как мы чистим зубы?",
      "uz": "Rasmlarni tartib bilan joylashtir: tishlarni qanday tozalaymiz?",
      "en": "Put the pictures in order: how do we brush our teeth?"
    }
  },
  "content": {
    "steps": [
      {
        "id": "wet",
        "imageId": "img_missing",
        "label": {
          "ru": "Намочить щётку",
          "uz": "Cho'tkani ho'llash",
          "en": "Wet the brush"
        }
      },
      {
        "id": "paste",
        "imageId": "img_teeth_paste",
        "label": {
          "ru": "Выдавить пасту",
          "uz": "Pasta surtish",
          "en": "Add toothpaste"
        }
      },
      {
        "id": "brush",
        "imageId": "img_teeth_brush",
        "label": {
          "ru": "Почистить зубы",
          "uz": "Tishlarni tozalash",
          "en": "Brush your teeth"
        }
      },
      {
        "id": "rinse",
        "imageId": "img_teeth_rinse",
        "label": {
          "ru": "Прополоскать рот",
          "uz": "Og'izni chayish",
          "en": "Rinse your mouth"
        }
      }
    ]
  },
  "hints": [
    {
      "ru": "Что мы делаем самым первым?",
      "uz": "Eng avval nima qilamiz?",
      "en": "What do we do first?"
    }
  ],
