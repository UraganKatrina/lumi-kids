# Скопируйте в .env на сервере и заполните. Сам .env в репозиторий не попадает.
DATABASE_URL=postgres://lumi:CHANGE_ME@localhost:5432/lumi
PORT=3000
SESSION_TTL_HOURS=12
# 1 — применять миграции при старте (удобно для разработки)
MIGRATE_ON_START=0
# Число прокси перед сервером (например 1 за nginx), чтобы ограничение частоты видело адрес клиента
# TRUST_PROXY=1

# Проверка подписок. Магазин без настроек отвечает 503; заполнять все строки магазина или ни одной.
PURCHASE_PRODUCT_IDS=lumi_premium_monthly,lumi_premium_yearly
# Google Play: JSON-ключ сервисного аккаунта с доступом к Play Console (файл держать вне репозитория)
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON_FILE=
# App Store: ключ App Store Connect API (In-App Purchase), файл .p8 вне репозитория
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
# 1 — если покупки нет в боевом App Store, искать в песочнице (TestFlight). На проде обычно 0.
APPLE_ALLOW_SANDBOX=0
